' Pendant macropump. Tick Config / General Config / Run Macro Pump.
' Talks to the pendant with two files (Mach3 VB cannot reliably do HTTP):
'   C:\Mach3\pendant-status.txt  (this script writes DRO/LEDs)
'   C:\Mach3\pendant-cmd.txt     (Python writes jog/Stop/Reset)
' If this is running, C:\Mach3\pendant-pump.log updates every cycle.

On Error Resume Next

Dim x, y, z, estop, resetok, incycle, fro
Dim body, resp, rest, p
Dim jx, jy, jz, stopCmd, resetCmd, froCmd, modeCmd
Dim spaxis, spdir, spsize
Dim lastStop, lastReset, lastMode, lastFro, lastStep

x = CLng(GetDRO(0) * 10000)
y = CLng(GetDRO(1) * 10000)
z = CLng(GetDRO(2) * 10000)
If GetOEMLED(19) <> 0 Then
  estop = 1
Else
  estop = 0
End If
If GetOEMLED(800) <> 0 Then
  resetok = 1
Else
  resetok = 0
End If
If GetOEMLED(804) <> 0 Then
  incycle = 1
Else
  incycle = 0
End If
fro = CLng(GetOEMDRO(818))
body = x & "|" & y & "|" & z & "|" & estop & "|" & resetok & "|" & incycle & "|" & fro

Err.Clear
Open "C:\Mach3\pendant-status.txt" For Output As #1
Print #1, body
Close #1

Open "C:\Mach3\pendant-pump.log" For Output As #1
Print #1, "macropump running"
Print #1, body
Close #1

jx = 0
jy = 0
jz = 0
stopCmd = 0
resetCmd = 0
froCmd = 100
modeCmd = 0
spaxis = -1
spdir = 0
spsize = 0
resp = ""

Err.Clear
Open "C:\Mach3\pendant-cmd.txt" For Input As #1
Line Input #1, resp
Close #1

If Err.Number <> 0 Then
  JogOff(0)
  JogOff(1)
  JogOff(2)
  Err.Clear
Else
If resp <> "" Then
  rest = resp & "|"
  p = InStr(rest, "|")
  jx = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  jy = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  jz = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  stopCmd = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  resetCmd = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  froCmd = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  modeCmd = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  spaxis = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  spdir = CLng(Left(rest, p - 1))
  rest = Mid(rest, p + 1)
  p = InStr(rest, "|")
  If p = 0 Then
    spsize = CLng(rest)
  Else
    spsize = CLng(Left(rest, p - 1))
  End If

  lastStop = GetUserDRO(2200)
  lastReset = GetUserDRO(2201)
  lastMode = GetUserDRO(2202)
  lastFro = GetUserDRO(2203)
  lastStep = GetUserDRO(2204)

  If modeCmd <> lastMode Then
    If modeCmd = 1 Then
      DoOEMButton(205)
    Else
      DoOEMButton(204)
    End If
  End If
  SetUserDRO(2202, modeCmd)

  If froCmd <> lastFro Then
    SetOEMDRO(818, froCmd)
    SetUserDRO(2203, froCmd)
  End If

  If stopCmd <> 0 Then
    If lastStop = 0 Then
      DoOEMButton(1003)
      JogOff(0)
      JogOff(1)
      JogOff(2)
    End If
  End If
  SetUserDRO(2200, stopCmd)

  If resetCmd <> 0 Then
    If lastReset = 0 Then
      DoOEMButton(1021)
    End If
  End If
  SetUserDRO(2201, resetCmd)

  If spaxis >= 0 Then
    If lastStep = 0 Then
      SetOEMDRO(3, spsize / 1000)
      JogOn(spaxis, spdir)
      JogOff(spaxis)
    End If
    SetUserDRO(2204, 1)
  Else
    SetUserDRO(2204, 0)
    If jx = 1 Then
      JogOn(0, 0)
    Else
      If jx = 2 Then
        JogOn(0, 1)
      Else
        JogOff(0)
      End If
    End If
    If jy = 1 Then
      JogOn(1, 0)
    Else
      If jy = 2 Then
        JogOn(1, 1)
      Else
        JogOff(1)
      End If
    End If
    If jz = 1 Then
      JogOn(2, 0)
    Else
      If jz = 2 Then
        JogOn(2, 1)
      Else
        JogOff(2)
      End If
    End If
  End If
End If
End If
